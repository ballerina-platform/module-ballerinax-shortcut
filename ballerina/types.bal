# The changes that have occurred as a result of the action
public type HistoryChangesStory record {|
    # The change to the workflow state of the story
    @jsondata:Name {value: "workflow_state_id"}
    StoryHistoryChangeOldNewInt workflowStateId?;
    # True if the Story has archived, otherwise false
    StoryHistoryChangeOldNewBool blocker?;
    # The change to the member that requested the story
    @jsondata:Name {value: "requested_by_id"}
    StoryHistoryChangeOldNewUuid requestedById?;
    # The commits added to or removed from the story
    @jsondata:Name {value: "commit_ids"}
    StoryHistoryChangeAddsRemovesInt commitIds?;
    # A timestamp that represents the Story's deadline
    StoryHistoryChangeOldNewStr description?;
    # The change to the type of the story
    @jsondata:Name {value: "story_type"}
    StoryHistoryChangeOldNewStr storyType?;
    # True if the Story has archived, otherwise false
    StoryHistoryChangeOldNewBool archived?;
    # The change to the parent story of the story
    @jsondata:Name {value: "parent_story_id"}
    StoryHistoryChangeOldNewInt parentStoryId?;
    # True if the Story has archived, otherwise false
    StoryHistoryChangeOldNewBool blocked?;
    # The change to the project of the story
    @jsondata:Name {value: "project_id"}
    StoryHistoryChangeOldNewInt projectId?;
    # The followers added to or removed from the story
    @jsondata:Name {value: "follower_ids"}
    StoryHistoryChangeAddsRemovesUuid followerIds?;
    # The estimate value for the Story
    StoryHistoryChangeOldNewInt estimate?;
    # A timestamp that represents the Story's deadline
    StoryHistoryChangeOldNewStr deadline?;
    # The story links added to or removed from the story as the subject
    @jsondata:Name {value: "subject_story_link_ids"}
    StoryHistoryChangeAddsRemovesInt subjectStoryLinkIds?;
    # The labels added to or removed from the story
    @jsondata:Name {value: "label_ids"}
    StoryHistoryChangeAddsRemovesInt labelIds?;
    # True if the Story has archived, otherwise false
    StoryHistoryChangeOldNewBool started?;
    # True if the Story has archived, otherwise false
    StoryHistoryChangeOldNewBool completed?;
    # The custom field values added to or removed from the story
    @jsondata:Name {value: "custom_field_value_ids"}
    StoryHistoryChangeAddsRemovesUuid customFieldValueIds?;
    # The tasks added to or removed from the story
    @jsondata:Name {value: "task_ids"}
    StoryHistoryChangeAddsRemovesInt taskIds?;
    # The change to the iteration of the story
    @jsondata:Name {value: "iteration_id"}
    StoryHistoryChangeOldNewInt iterationId?;
    # The change to the group of the story
    @jsondata:Name {value: "group_id"}
    StoryHistoryChangeOldNewUuid groupId?;
    # The branches added to or removed from the story
    @jsondata:Name {value: "branch_ids"}
    StoryHistoryChangeAddsRemovesInt branchIds?;
    # A timestamp that represents the Story's deadline
    StoryHistoryChangeOldNewStr name?;
    # The story links added to or removed from the story as the object
    @jsondata:Name {value: "object_story_link_ids"}
    StoryHistoryChangeAddsRemovesInt objectStoryLinkIds?;
    # Members added to or removed from the owners
    @jsondata:Name {value: "owner_ids"}
    StoryHistoryChangeAddsRemovesUuid ownerIds?;
    # Members added to or removed from the mentions
    @jsondata:Name {value: "mention_ids"}
    StoryHistoryChangeAddsRemovesUuid mentionIds?;
    # The change to the epic of the story
    @jsondata:Name {value: "epic_id"}
    StoryHistoryChangeOldNewInt epicId?;
|};

# Request parameters for creating a Story Link within a Story
public type CreateStoryLinkParams record {|
    # The unique ID of the Story defined as subject
    @jsondata:Name {value: "subject_id"}
    int subjectId?;
    # How the subject Story acts on the object Story. This can be "blocks", "duplicates", or "relates to"
    "blocks"|"duplicates"|"relates to" verb;
    # The unique ID of the Story defined as object
    @jsondata:Name {value: "object_id"}
    int objectId?;
|};

# A reference to a Group
public type HistoryReferenceGroup record {|
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The name of the entity referenced
    string name;
    # The ID of the entity referenced
    string id;
|};

# Request parameters for changing either a template's name or any of
#   the attributes it is designed to pre-populate
public type UpdateEntityTemplate record {|
    # The updated template name
    @constraint:String {maxLength: 128, minLength: 1}
    string name?;
    # The story contents the template creates
    @jsondata:Name {value: "story_contents"}
    UpdateStoryContents storyContents?;
|};

public type CreateEpicComment record {|
    # Defaults to the time/date the comment is last updated, but can be set to reflect another date
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Defaults to the time/date the comment is created, but can be set to reflect another date
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # This field can be set to another unique ID. In the case that the comment has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # The comment text
    @constraint:String {maxLength: 100000, minLength: 1}
    string text;
    # The Member ID of the Comment's author. Defaults to the user identified by the API token
    @jsondata:Name {value: "author_id"}
    string authorId?;
|};

public type CreateStories record {|
    # An array of stories to be created
    CreateStoryParams[] stories;
|};

# Request parameters for creating a story
public type CreateStoryParams record {|
    # The ID of the workflow state the story will be in
    @jsondata:Name {value: "workflow_state_id"}
    int workflowStateId?;
    # The ID of the member that requested the story
    @jsondata:Name {value: "requested_by_id"}
    string requestedById?;
    # The description of the story
    @constraint:String {maxLength: 100000}
    string description?;
    # An array of IDs of linked files attached to the story
    @jsondata:Name {value: "linked_file_ids"}
    int[] linkedFileIds?;
    # The time/date the Story was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # This field can be set to another unique ID. In the case that the Story has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # The type of story (feature, bug, chore)
    @jsondata:Name {value: "story_type"}
    "feature"|"chore"|"bug" storyType?;
    # Controls the story's archived state
    boolean archived?;
    # The ID of the parent story to associate with this story (making the created story a sub-task).
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "parent_story_id"}
    int? parentStoryId?;
    # The time/date the Story was updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # The id of the story template used to create this story, if applicable. This is just an association; no content from the story template is inherited by the story simply by setting this field
    @jsondata:Name {value: "story_template_id"}
    string? storyTemplateId?;
    # The ID of the project the story belongs to
    @jsondata:Name {value: "project_id"}
    int? projectId?;
    # An array of UUIDs of the followers of this story
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds?;
    # An array of IDs of files attached to the story
    @jsondata:Name {value: "file_ids"}
    int[] fileIds?;
    # The numeric point estimate of the story. Can also be null, which means unestimated
    int? estimate?;
    # The due date of the story
    string? deadline?;
    # An array of tasks connected to the story
    CreateTaskParams[] tasks?;
    # An array of comments to add to the story
    CreateStoryCommentParams[] comments?;
    # A map specifying a CustomField ID and CustomFieldEnumValue ID that represents an assertion of some value for a CustomField
    @jsondata:Name {value: "custom_fields"}
    CustomFieldValueParams[] customFields?;
    # An array of story links attached to the story
    @jsondata:Name {value: "story_links"}
    CreateStoryLinkParams[] storyLinks?;
    # An array of labels attached to the story
    CreateLabelParams[] labels?;
    # The ID of the iteration the story belongs to
    @jsondata:Name {value: "iteration_id"}
    int? iterationId?;
    # A manual override for the time/date the Story was started
    @jsondata:Name {value: "started_at_override"}
    string startedAtOverride?;
    # The id of the group to associate with this story
    @jsondata:Name {value: "group_id"}
    string? groupId?;
    # One of "first" or "last". This can be used to move the given story to the first or last position in the workflow state
    @jsondata:Name {value: "move_to"}
    "last"|"first" moveTo?;
    # An array of External Links associated with this story
    @jsondata:Name {value: "external_links"}
    string[] externalLinks?;
    # The name of the story
    @constraint:String {maxLength: 512, minLength: 1}
    string name;
    # An array of maps specifying sub-tasks to be associated with the created story. Each map can either link to an existing story or create a new sub-task story to be linked to the created story.
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "sub_tasks"}
    CreateStoryFromTemplateParamsSubTasks[] subTasks?;
    # Given this story was converted from a task in another story, this is the original task ID that was converted to this story
    @jsondata:Name {value: "source_task_id"}
    int? sourceTaskId?;
    # A manual override for the time/date the Story was completed
    @jsondata:Name {value: "completed_at_override"}
    string completedAtOverride?;
    # An array of UUIDs of the owners of this story
    @jsondata:Name {value: "owner_ids"}
    string[] ownerIds?;
    # The ID of the epic the story belongs to
    @jsondata:Name {value: "epic_id"}
    int? epicId?;
|};

# (Deprecated) A Milestone is a collection of Epics that represent a release or some other large initiative that you are working on. Milestones have become Objectives, so you should use Objective-related API resources instead of Milestone ones
public type Milestone record {|
    # The Shortcut application url for the Milestone
    @jsondata:Name {value: "app_url"}
    string appUrl;
    # The globally unique identifier of the resource
    @jsondata:Name {value: "global_id"}
    string globalId;
    # The Milestone's description
    string description;
    # The time/date the Milestone was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # A true/false boolean indicating if the Milestone has been started
    boolean started;
    # A true/false boolean indicating if the Milestone has been completed
    boolean completed;
    # A boolean indicating whether the Milestone has been archived or not
    boolean archived;
    # The time/date the Milestone was completed
    @jsondata:Name {value: "completed_at"}
    string? completedAt;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # A manual override for the time/date the Milestone was started
    @jsondata:Name {value: "started_at_override"}
    string? startedAtOverride;
    # The time/date the Milestone was updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt;
    # A group of calculated values for this Milestone
    MilestoneStats stats;
    # The name of the Milestone
    string name;
    # The time/date the Milestone was started
    @jsondata:Name {value: "started_at"}
    string? startedAt;
    # The workflow state that the Milestone is in
    string state;
    # An array of Categories attached to the Milestone
    Category[] categories;
    # The unique ID of the Milestone
    int id;
    # A number representing the position of the Milestone in relation to every other Milestone within the Workspace
    int position;
    # A manual override for the time/date the Milestone was completed
    @jsondata:Name {value: "completed_at_override"}
    string? completedAtOverride;
    # The IDs of the Key Results associated with the Objective
    @jsondata:Name {value: "key_result_ids"}
    string[] keyResultIds;
|};

public type UpdateEpic record {|
    # The ID of the member that requested the epic
    @jsondata:Name {value: "requested_by_id"}
    string requestedById?;
    # `Deprecated` The ID of the Milestone this Epic is related to. Use `objective_ids`
    @jsondata:Name {value: "milestone_id"}
    int? milestoneId?;
    # The Epic's description
    @constraint:String {maxLength: 100000}
    string description?;
    # This field can be set to another unique ID. In the case that the Epic has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # An array of Labels attached to the Epic
    CreateLabelParams[] labels?;
    # An array of IDs for Objectives to which this Epic is related
    @jsondata:Name {value: "objective_ids"}
    int[] objectiveIds?;
    # A true/false boolean indicating whether the Epic is in archived state
    boolean archived?;
    # A manual override for the time/date the Epic was started
    @jsondata:Name {value: "started_at_override"}
    string? startedAtOverride?;
    # `Deprecated` The ID of the group to associate with the epic. Use `group_ids`
    @jsondata:Name {value: "group_id"}
    string? groupId?;
    # The ID of the Epic State
    @jsondata:Name {value: "epic_state_id"}
    int epicStateId?;
    # An array of UUIDs for any Members you want to add as Followers on this Epic
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds?;
    # The Epic's name
    @constraint:String {maxLength: 256, minLength: 1}
    string name?;
    # The Epic's planned start date
    @jsondata:Name {value: "planned_start_date"}
    string? plannedStartDate?;
    # An array of UUIDS for Groups to which this Epic is related
    @jsondata:Name {value: "group_ids"}
    string[] groupIds?;
    # The ID of the Epic we want to move this Epic after
    @jsondata:Name {value: "after_id"}
    int afterId?;
    # `Deprecated` The Epic's state (to do, in progress, or done); will be ignored when `epic_state_id` is set
    "in progress"|"to do"|"done" state?;
    # The Epic's deadline
    string? deadline?;
    # A manual override for the time/date the Epic was completed
    @jsondata:Name {value: "completed_at_override"}
    string? completedAtOverride?;
    # An array of UUIDs for any members you want to add as Owners on this Epic
    @jsondata:Name {value: "owner_ids"}
    string[] ownerIds?;
    # The ID of the Epic we want to move this Epic before
    @jsondata:Name {value: "before_id"}
    int beforeId?;
|};


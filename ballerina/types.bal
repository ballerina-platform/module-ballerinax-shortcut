public type CreateStoryContents record {|
    # The ID of the workflow state to be populated
    @jsondata:Name {value: "workflow_state_id"}
    int? workflowStateId?;
    # An array of maps specifying a CustomField ID and CustomFieldEnumValue ID that represents an assertion of some value for a CustomField
    @jsondata:Name {value: "custom_fields"}
    CustomFieldValueParams[] customFields?;
    # The description of the story
    string description?;

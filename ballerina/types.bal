    boolean enabled;
|};

public type CreateGroup record {|
    # The card aging mode for stories in this Group: "gradual" (fixed fade steps at 1, 2, and 4 weeks), "immediate", or "off" (explicitly disabled for this Group). Set to null to inherit the Workspace default
    @jsondata:Name {value: "card_aging_mode"}
    "off"|"gradual"|"immediate"? cardAgingMode?;
    # The Workflow ids to add to the Group
    @jsondata:Name {value: "workflow_ids"}
    int[] workflowIds?;
    # The mention name of this Group
    @jsondata:Name {value: "mention_name"}
    string mentionName;
    # The Icon id for the avatar of this Group
    @jsondata:Name {value: "display_icon_id"}
    string displayIconId?;
    # The color you wish to use for the Group in the system
    @constraint:String {minLength: 1, pattern: re `^#[a-fA-F0-9]{6}$`}
    string color?;
    # The color key you wish to use for the Group in the system
    @jsondata:Name {value: "color_key"}
    "blue"|"purple"|"midnight-blue"|"orange"|"yellow-green"|"brass"|"gray"|"fuchsia"|"yellow"|"pink"|"sky-blue"|"green"|"red"|"black"|"slate"|"turquoise" colorKey?;
    # The Member ids to add to this Group
    @jsondata:Name {value: "member_ids"}
    string[] memberIds?;
    # The name of this Group
    @constraint:String {maxLength: 63, minLength: 1}
    string name;
    # The description of the Group
    @constraint:String {maxLength: 4096}
    string description?;
    # The number of days an in-progress Story can go without activity before it is considered stale. Required when card_aging_mode is "immediate"; not allowed otherwise
    @jsondata:Name {value: "card_aging_threshold_days"}
    int? cardAgingThresholdDays?;
|};

public type CreateStoryComment record {|
    # Defaults to the time/date the comment is last updated, but can be set to reflect another date
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # The ID of the Comment that this comment is threaded under
    @jsondata:Name {value: "parent_id"}
    int? parentId?;
    # Defaults to the time/date the comment is created, but can be set to reflect another date
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # This field can be set to another unique ID. In the case that the comment has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # The comment text
    @constraint:String {maxLength: 100000}
    string text;
    # The Member ID of the Comment's author. Defaults to the user identified by the API token
    @jsondata:Name {value: "author_id"}
    string authorId?;
|};


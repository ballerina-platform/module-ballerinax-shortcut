    # The Member IDs contain within the Group
    @jsondata:Name {value: "member_ids"}
    string[] memberIds;
    # The globally unique identifier of the resource
    @jsondata:Name {value: "global_id"}
    string globalId;
    # The description of the Group
    string description;
    # The instant when this group was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # The number of days an in-progress Story can go without activity before it is considered stale
    @jsondata:Name {value: "card_aging_threshold_days"}
    int? cardAgingThresholdDays;
    # The number of stories assigned to the group which are in a backlog workflow state
    @jsondata:Name {value: "num_stories_backlog"}
    int numStoriesBacklog;
    # The number of stories assigned to the group which are in a started workflow state
    @jsondata:Name {value: "num_stories_started"}
    int numStoriesStarted;
    # The number of epics assigned to the group which are in the started workflow state
    @jsondata:Name {value: "num_epics_started"}
    int numEpicsStarted;
    # The Workflow IDs contained within the Group
    @jsondata:Name {value: "workflow_ids"}
    int[] workflowIds;
    # Whether or not the Group is archived
    boolean archived;
    # The ID of the default workflow for stories created in this group
    @jsondata:Name {value: "default_workflow_id"}
    int? defaultWorkflowId?;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The color key to be displayed with the Group
    @jsondata:Name {value: "color_key"}
    "blue"|"purple"|"midnight-blue"|"orange"|"yellow-green"|"brass"|"gray"|"fuchsia"|"yellow"|"pink"|"sky-blue"|"green"|"red"|"black"|"slate"|"turquoise"? colorKey;
    # The last instant when this group was updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt;
    # The icon displayed for the entity
    @jsondata:Name {value: "display_icon"}
    Icon displayIcon;
    # The name of the Group
    string name;
    # The id of the Group
    string id;
|};


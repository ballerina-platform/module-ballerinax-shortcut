    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # This field can be set to another unique ID. In the case that the comment has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # The comment text
    @constraint:String {maxLength: 100000}
    string text;
    # The Member ID of the Comment's author. Defaults to the user identified by the API token
    @jsondata:Name {value: "author_id"}
    string authorId?;
|};

public type CreateLinkedFile record {|
    # The UUID of the member that uploaded the file
    @jsondata:Name {value: "uploader_id"}
    string uploaderId?;
    # The filesize, if the integration provided it
    int size?;
    # The content type of the image (e.g. txt/plain)
    @jsondata:Name {value: "content_type"}
    string contentType?;
    # The ID of the linked story
    @jsondata:Name {value: "story_id"}
    int storyId?;
    # The name of the file
    @constraint:String {maxLength: 256, minLength: 1}
    string name;
    # The description of the file
    @constraint:String {maxLength: 512}
    string description?;
    # The URL of the thumbnail, if the integration provided it
    @jsondata:Name {value: "thumbnail_url"}
    string thumbnailUrl?;
    # The integration type of the file (e.g. google, dropbox, box)
    "google"|"url"|"dropbox"|"box"|"onedrive" 'type;
    # The URL of linked file
    @constraint:String {maxLength: 2048, pattern: re `^https?://.+$`}
    string url;
|};

# Represents the Queries record for the operation: searchIterations
public type SearchIterationsQueries record {
    # The next page token
    string next?;
    # See our help center article on [search operators](https://help.shortcut.com/hc/en-us/articles/360000046646-Search-Operators)
    @constraint:String {minLength: 1}
    string query;
    # A collection of entity_types to search. Defaults to story and epic. Supports: epic, iteration, objective, story
    @http:Query {name: "entity_types"}
    ("story"|"milestone"|"epic"|"iteration"|"objective")[] entityTypes?;
    # The amount of detail included in each result item.
    #    "full" will include all descriptions and comments and more fields on
    #    related items such as pull requests, branches and tasks.
    #    "slim" omits larger fulltext fields such as descriptions and comments
    #    and only references related items by id.
    #    The default is "full"
    "full"|"slim" detail?;
    # The number of search results to include in a page. Minimum of 1 and maximum of 250
    @http:Query {name: "page_size"}
    int pageSize?;
};

# Updated attributes for the template to populate
public type UpdateStoryContents record {|
    # The ID of the workflow state to be populated
    @jsondata:Name {value: "workflow_state_id"}
    int? workflowStateId?;
    # An array of maps specifying a CustomField ID and CustomFieldEnumValue ID that represents an assertion of some value for a CustomField
    @jsondata:Name {value: "custom_fields"}
    CustomFieldValueParams[] customFields?;
    # The description of the story
    string description?;
    # An array of the linked file IDs to be populated
    @jsondata:Name {value: "linked_file_ids"}
    int[] linkedFileIds?;
    # An array of labels to be populated by the template
    CreateLabelParams[] labels?;
    # The ID of the iteration the to be populated
    @jsondata:Name {value: "iteration_id"}
    int? iterationId?;
    # The type of story (feature, bug, chore)
    @jsondata:Name {value: "story_type"}
    string storyType?;
    # The ID of the group to be populated
    @jsondata:Name {value: "group_id"}
    string? groupId?;
    # The ID of the project the story belongs to
    @jsondata:Name {value: "project_id"}
    int? projectId?;
    # An array of external links to be populated
    @jsondata:Name {value: "external_links"}
    string[] externalLinks?;
    # An array of UUIDs for any Members listed as Followers
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds?;
    # An array of the attached file IDs to be populated
    @jsondata:Name {value: "file_ids"}
    int[] fileIds?;
    # The name of the story
    string name?;
    # The numeric point estimate to be populated
    int? estimate?;
    # An array of maps specifying the sub-tasks to create and link to the story.
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "sub_tasks"}
    CreateSubTaskParams[] subTasks?;
    # The due date of the story
    string? deadline?;
    # An array of tasks to be populated by the template
    BaseTaskParams[] tasks?;
    # An array of UUIDs of the owners of this story
    @jsondata:Name {value: "owner_ids"}
    string[] ownerIds?;
    # The ID of the epic the to be populated
    @jsondata:Name {value: "epic_id"}
    int? epicId?;
|};

# An action representing a Story being deleted
public type HistoryActionStoryDelete record {|
    # The type of Story; either feature, bug, or chore
    @jsondata:Name {value: "story_type"}
    "feature"|"chore"|"bug" storyType;
    # The Story's Parent ID (only applicable if Story is a Sub-task)
    @jsondata:Name {value: "parent_story_id"}
    int parentStoryId?;
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The name of the Story
    string name;
    # The action of the entity referenced
    "delete" action;
    # The ID of the entity referenced
    int id;
|};

# Commit refers to a VCS commit and all associated details
public type Commit record {|
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The time/date the Commit was updated
    @jsondata:Name {value: "updated_at"}
    string? updatedAt;
    # The identity of the commit author
    @jsondata:Name {value: "author_identity"}
    Identity authorIdentity;
    # The email address of the VCS user that authored the Commit
    @jsondata:Name {value: "author_email"}
    string authorEmail;
    # The time/date the Commit was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # The ID of the Repository that contains the Commit
    @jsondata:Name {value: "repository_id"}
    int? repositoryId;
    # The unique ID of the Commit
    int? id;
    # The ID of the Member that authored the Commit, if known
    @jsondata:Name {value: "author_id"}
    string? authorId;
    # The Commit message
    string message;
    # The Commit hash
    string hash;
    # The URL of the Commit
    string url;
    # The time/date the Commit was pushed
    string timestamp;
|};

public type UpdateObjective record {|
    # A boolean indicating whether the Objective is archived or not
    boolean archived?;
    # A manual override for the time/date the Objective was started
    @jsondata:Name {value: "started_at_override"}
    string? startedAtOverride?;
    # The name of the Objective
    @constraint:String {maxLength: 256, minLength: 1}
    string name?;
    # The Objective's description
    @constraint:String {maxLength: 100000}
    string description?;
    # The ID of the Objective we want to move this Objective after
    @jsondata:Name {value: "after_id"}
    int afterId?;
    # The workflow state that the Objective is in
    "in progress"|"to do"|"done" state?;
    # An array of IDs of Categories attached to the Objective
    CreateCategoryParams[] categories?;
    # A manual override for the time/date the Objective was completed
    @jsondata:Name {value: "completed_at_override"}
    string? completedAtOverride?;
    # The ID of the Objective we want to move this Objective before
    @jsondata:Name {value: "before_id"}
    int beforeId?;
|};

public type UpdateProject record {|
    # The number of days before the thermometer appears in the Story summary
    @jsondata:Name {value: "days_to_thermometer"}
    int daysToThermometer?;
    # A true/false boolean indicating whether the Story is in archived state
    boolean archived?;
    # Configuration to enable or disable thermometers in the Story summary
    @jsondata:Name {value: "show_thermometer"}
    boolean showThermometer?;
    # The color that represents the Project in the UI
    @constraint:String {minLength: 1, pattern: re `^#[a-fA-F0-9]{6}$`}
    string color?;
    # An array of UUIDs for any Members you want to add as Followers
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds?;
    # The Project's name
    @constraint:String {maxLength: 128, minLength: 1}
    string name?;
    # The Project's description
    @constraint:String {maxLength: 100000}
    string description?;
    # The ID of the team the project belongs to
    @jsondata:Name {value: "team_id"}
    int teamId?;
    # The Project abbreviation used in Story summaries. Should be kept to 3 characters at most
    string abbreviation?;
|};

# The stats object for Stories
public type StoryStats record {|
    # The number of documents related to this Story
    @jsondata:Name {value: "num_related_documents"}
    int numRelatedDocuments;
|};

public type CustomField record {|
    # The canonical name for a Shortcut-defined field
    @jsondata:Name {value: "canonical_name"}
    string canonicalName?;
    # A collection of legal values for a CustomField
    CustomFieldEnumValue[] values?;
    # A string description of the CustomField
    @constraint:String {maxLength: 512, minLength: 1}
    string description?;
    # The instant when this CustomField was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # A string that represents the icon that corresponds to this custom field
    @jsondata:Name {value: "icon_set_identifier"}
    string iconSetIdentifier?;
    # When true, the CustomField can be applied to entities in the Workspace
    boolean enabled;
    # The types of stories this CustomField is scoped to
    @jsondata:Name {value: "story_types"}
    string[] storyTypes?;
    # When true, the CustomFieldEnumValues may not be reordered
    @jsondata:Name {value: "fixed_position"}
    boolean fixedPosition?;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    "custom-field" entityType;
    # The instant when this CustomField was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt;
    # The name of the Custom Field
    @constraint:String {maxLength: 63, minLength: 1}
    string name;
    # The unique public ID for the CustomField
    string id;
    # An integer indicating the position of this Custom Field with respect to the other CustomField
    int position;
    # The type of Custom Field, eg. 'enum'
    @jsondata:Name {value: "field_type"}
    "enum" fieldType;
|};


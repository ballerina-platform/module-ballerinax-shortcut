# A Story in search results. This is typed differently from Story because the details=slim search argument will omit some fields
public type StorySearchResult record {|
    # The ID of the workflow state the story is currently in
    @jsondata:Name {value: "workflow_state_id"}
    int workflowStateId;
    # The ID of the workflow the story belongs to
    @jsondata:Name {value: "workflow_id"}
    int workflowId;
    # The ID of the Member that requested the story
    @jsondata:Name {value: "requested_by_id"}
    string requestedById;
    # An array of Pull/Merge Requests attached to the story
    @jsondata:Name {value: "pull_requests"}
    PullRequest[] pullRequests?;
    # The ID of the story template used to create this story, or null if not created using a template
    @jsondata:Name {value: "story_template_id"}
    string? storyTemplateId;
    # The ID of the project the story belongs to
    @jsondata:Name {value: "project_id"}
    int? projectId;
    # The stats object for Stories
    StoryStats stats;
    # The numeric point estimate of the story. Can also be null, which means unestimated
    int? estimate;
    # The unique ID of the Story
    int id;
    # An array of tasks connected to the story
    Task[] tasks?;
    # The Story IDs of Sub-tasks attached to the Story
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "sub_task_story_ids"}
    int[] subTaskStoryIds?;
    # An array of CustomField value assertions for the story
    @jsondata:Name {value: "custom_fields"}
    StoryCustomField[] customFields?;
    # The formatted branch name for this story
    @jsondata:Name {value: "formatted_vcs_branch_name"}
    string? formattedVcsBranchName?;
    # An array of label ids attached to the story
    @jsondata:Name {value: "label_ids"}
    int[] labelIds;
    # The globally unique identifier of the resource
    @jsondata:Name {value: "global_id"}
    string globalId;
    # A true/false boolean indicating if the Story has been completed
    boolean completed;
    # An array of Git branches attached to the story
    Branch[] branches?;
    # An array of labels attached to the story
    LabelSlim[] labels;
    # The ID of the iteration the story belongs to
    @jsondata:Name {value: "iteration_id"}
    int? iterationId;
    # The time/date the Story was completed
    @jsondata:Name {value: "completed_at"}
    string? completedAt;
    # The IDs of the iteration the story belongs to
    @jsondata:Name {value: "previous_iteration_ids"}
    int[] previousIterationIds;
    # An array of external links (strings) associated with a Story
    @jsondata:Name {value: "external_links"}
    string[] externalLinks;
    # The name of the story
    string name;
    # The time/date the Story was started
    @jsondata:Name {value: "started_at"}
    string? startedAt;
    # An array of commits attached to the story
    Commit[] commits?;
    # An array of files attached to the story
    UploadedFile[] files?;
    # The cycle time (in seconds) of this story when complete
    @jsondata:Name {value: "cycle_time"}
    int cycleTime?;
    # A number representing the position of the story in relation to every other story in the current project
    int position;
    # A manual override for the time/date the Story was completed
    @jsondata:Name {value: "completed_at_override"}
    string? completedAtOverride;
    # An array of UUIDs of the owners of this story
    @jsondata:Name {value: "owner_ids"}
    string[] ownerIds;
    # An array of IDs of Comments attached to the story
    @jsondata:Name {value: "comment_ids"}
    int[] commentIds?;
    # `Deprecated:` use `member_mention_ids`
    @jsondata:Name {value: "mention_ids"}
    string[] mentionIds;
    # A true/false boolean indicating if the Story is currently a blocker of another story
    boolean blocker;
    # An array of linked files attached to the story
    @jsondata:Name {value: "linked_files"}
    LinkedFile[] linkedFiles?;
    # The description of the story
    string description?;
    # An array of IDs of LinkedFiles attached to the story
    @jsondata:Name {value: "linked_file_ids"}
    int[] linkedFileIds?;
    # The time/date the Story was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # An array of Group IDs that have been mentioned in the Story description
    @jsondata:Name {value: "group_mention_ids"}
    string[] groupMentionIds;
    # This field can be set to another unique ID. In the case that the Story has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string? externalId;
    # The type of story (feature, bug, chore)
    @jsondata:Name {value: "story_type"}
    string storyType;
    # True if the story has been archived or not
    boolean archived;
    # The ID of the parent story to this story (making this story a sub-task).
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "parent_story_id"}
    int? parentStoryId?;
    # The time/date the Story was updated
    @jsondata:Name {value: "updated_at"}
    string? updatedAt;
    # A true/false boolean indicating if the Story is currently blocked
    boolean blocked;
    # An array of UUIDs for any Members listed as Followers
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds;
    # The lead time (in seconds) of this story when complete
    @jsondata:Name {value: "lead_time"}
    int leadTime?;
    # An array of IDs of Files attached to the story
    @jsondata:Name {value: "file_ids"}
    int[] fileIds?;
    # The due date of the story
    string? deadline;
    # An array of Member IDs that have been mentioned in the Story description
    @jsondata:Name {value: "member_mention_ids"}
    string[] memberMentionIds;
    # The Shortcut application url for the Story
    @jsondata:Name {value: "app_url"}
    string appUrl;
    # An array of comments attached to the story
    StoryComment[] comments?;
    # The number of tasks on the story which are complete
    @jsondata:Name {value: "num_tasks_completed"}
    int numTasksCompleted?;
    # An array of story links attached to the Story
    @jsondata:Name {value: "story_links"}
    TypedStoryLink[] storyLinks;
    # A true/false boolean indicating if the Story has been started
    boolean started;
    # An array of IDs of Tasks attached to the story
    @jsondata:Name {value: "task_ids"}
    int[] taskIds?;
    # The external application the story is synced with
    @jsondata:Name {value: "synced_item"}
    SyncedItem syncedItem?;
    # The time/date the Story was last changed workflow-state
    @jsondata:Name {value: "moved_at"}
    string? movedAt;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # A manual override for the time/date the Story was started
    @jsondata:Name {value: "started_at_override"}
    string? startedAtOverride;
    # The ID of the group associated with the story
    @jsondata:Name {value: "group_id"}
    string? groupId;
    # The ID of the epic the story belongs to
    @jsondata:Name {value: "epic_id"}
    int? epicId;
|};

# An action representing a Task being updated
public type HistoryActionTaskUpdate record {|
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The Story ID that contains the Task

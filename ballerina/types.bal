    int storiesWithoutProjects;
    # The time/date the Epic was updated
    @jsondata:Name {value: "updated_at"}
    string? updatedAt;
    # A group of calculated values for this Epic
    EpicStats stats;
    # The ID of the Epic State
    @jsondata:Name {value: "epic_state_id"}
    int epicStateId;
    # The URL of the associated productboard feature
    @jsondata:Name {value: "productboard_url"}
    string? productboardUrl;
    # An array of UUIDs for any Members you want to add as Followers on this Epic
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds;
    # An array of UUIDS for Groups to which this Epic is related
    @jsondata:Name {value: "group_ids"}
    string[] groupIds;
    # `Deprecated` The workflow state that the Epic is in
    string state;
    # The unique ID of the Epic
    int id;
    # The Epic's deadline
    string? deadline;
    # An array of Member IDs that have been mentioned in the Epic description
    @jsondata:Name {value: "member_mention_ids"}
    string[] memberMentionIds;
    # The Shortcut application url for the Epic
    @jsondata:Name {value: "app_url"}
    string appUrl;
    # A nested array of threaded comments
    ThreadedComment[] comments?;
    # The ID of the associated productboard feature
    @jsondata:Name {value: "productboard_id"}
    string? productboardId;
    # An array of Label ids attached to the Epic
    @jsondata:Name {value: "label_ids"}
    int[] labelIds;
    # The globally unique identifier of the resource
    @jsondata:Name {value: "global_id"}
    string globalId;
    # The current health status of the Epic
    Health health?;
    # A true/false boolean indicating if the Epic has been started
    boolean started;
    # A true/false boolean indicating if the Epic has been completed
    boolean completed;
    # The IDs of Projects related to this Epic
    @jsondata:Name {value: "project_ids"}
    int[] projectIds;
    # An array of Labels attached to the Epic
    LabelSlim[] labels;
    # An array of IDs for Objectives to which this epic is related
    @jsondata:Name {value: "objective_ids"}
    int[] objectiveIds;
    # The time/date the Epic was completed
    @jsondata:Name {value: "completed_at"}
    string? completedAt;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # A manual override for the time/date the Epic was started
    @jsondata:Name {value: "started_at_override"}
    string? startedAtOverride;
    # `Deprecated` The ID of the group to associate with the epic. Use `group_ids`
    @jsondata:Name {value: "group_id"}
    string? groupId;
    # The name of the Epic
    string name;
    # The Epic's planned start date
    @jsondata:Name {value: "planned_start_date"}
    string? plannedStartDate;
    # The time/date the Epic was started
    @jsondata:Name {value: "started_at"}
    string? startedAt;
    # The Epic's relative position in the Epic workflow state
    int position;
    # A manual override for the time/date the Epic was completed
    @jsondata:Name {value: "completed_at_override"}
    string? completedAtOverride;
    # An array of UUIDs for any members you want to add as Owners on this new Epic

    "google"|"url"|"dropbox"|"box"|"onedrive" 'type?;
    # The URL of linked file
    @constraint:String {maxLength: 2048, pattern: re `^https?://.+$`}
    string url?;
|};

# An action representing a VCS Branch being created
public type HistoryActionBranchCreate record {|
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The name of the VCS Branch that was pushed
    string name;
    # The action of the entity referenced
    "create" action;
    # The ID of the entity referenced
    int id;
    # The URL from the provider of the VCS Branch that was pushed
    string url;
|};

# Represents the Queries record for the operation: searchDocuments
public type SearchDocumentsQueries record {
    # The next page token
    string next?;
    # When true, find archived documents. When false, find non-archived documents
    boolean archived?;
    # When true, find documents that the current user is following. When false, find documents NOT followed
    @http:Query {name: "followed_by_me"}
    boolean followedByMe?;
    # Search text to match against document titles. Supports fuzzy matching. Required
    @constraint:String {minLength: 1}
    string title;
    # When true, find documents created by the current user. When false, find documents NOT created by current user
    @http:Query {name: "created_by_me"}
    boolean createdByMe?;
    # The number of search results to include in a page. Minimum of 1 and maximum of 250
    @http:Query {name: "page_size"}
    int pageSize?;
};

# A Category can be used to associate Objectives
public type Category record {|
    # A true/false boolean indicating if the Category has been archived
    boolean archived;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The hex color to be displayed with the Category (for example, "#ff0000")
    string? color;
    # The time/date that the Category was updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt;
    # The name of the Category
    string name;
    # The Global ID of the Category
    @jsondata:Name {value: "global_id"}
    string globalId;
    # The time/date that the Category was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # This field can be set to another unique ID. In the case that the Category has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string? externalId;
    # The unique ID of the Category
    int id;
    # The type of entity this Category is associated with; currently Milestone or Objective is the only type of Category
    string 'type;
|};

# The results of the Story search query
public type StorySearchResults record {|
    # The URL path and query string for the next page of search results
    string? next;
    # The total number of matches for the search query. The first 1000 matches can be paged through via the API
    int total;
    # A list of search results
    StorySearchResult[] data;
|};

public type CreateCommentComment record {|
    # Defaults to the time/date the comment is last updated, but can be set to reflect another date
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Defaults to the time/date the comment is created, but can be set to reflect another date
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # This field can be set to another unique ID. In the case that the comment has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string externalId?;
    # The comment text
    @constraint:String {maxLength: 100000, minLength: 1}
    string text;
    # The Member ID of the Comment's author. Defaults to the user identified by the API token
    @jsondata:Name {value: "author_id"}
    string authorId?;
|};

# A reference to a VCS Branch
public type HistoryReferenceBranch record {|
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The name of the entity referenced
    string name;
    # The ID of the entity referenced
    int|string id;
    # The external URL for the Branch
    @constraint:String {maxLength: 2048, pattern: re `^https?://.+$`}
    string url;
|};

# The type of Story Link. The string can be subject or object. 
public type TypedStoryLink record {|
    # The ID of the subject Story
    @jsondata:Name {value: "subject_id"}
    int subjectId;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The time/date when the Story Link was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt;
    # The workflow state of the "subject" story
    @jsondata:Name {value: "subject_workflow_state_id"}
    int subjectWorkflowStateId;
    # How the subject Story acts on the object Story. This can be "blocks", "duplicates", or "relates to"
    string verb;
    # The time/date when the Story Link was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # The unique identifier of the Story Link
    int id;
    # This indicates whether the Story is the subject or object in the Story Link
    string 'type;
    # The ID of the object Story
    @jsondata:Name {value: "object_id"}
    int objectId;
|};

# The results of the Document search query
public type DocSearchResults record {|
    # The URL path and query string for the next page of search results
    string? next;
    # The total number of matches for the search query. The first 1000 matches can be paged through via the API
    int total;
    # A list of document search results
    DocSlim[] data;
|};

# Request parameters for creating a Comment on a Shortcut Story
public type CreateStoryCommentParams record {|
    # Defaults to the time/date the comment is last updated, but can be set to reflect another date

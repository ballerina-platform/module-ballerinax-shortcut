    int objectiveId;
    @jsondata:Name {value: "initial_observed_value"}
    KeyResultValue initialObservedValue;
|};

# Represents the Queries record for the operation: searchEpics
public type SearchEpicsQueries record {
    # The next page token
    string next?;
    # See our help center article on [search operators](https://help.shortcut.com/hc/en-us/articles/360000046646-Search-Operators)
    @constraint:String {minLength: 1}
    string query;
    # A collection of entity_types to search. Defaults to story and epic. Supports: epic, iteration, objective, story
    @http:Query {name: "entity_types"}
    ("story"|"milestone"|"epic"|"iteration"|"objective")[] entityTypes?;
    # The amount of detail included in each result item.
    #    "full" will include all descriptions and comments and more fields on
    #    related items such as pull requests, branches and tasks.
    #    "slim" omits larger fulltext fields such as descriptions and comments
    #    and only references related items by id.
    #    The default is "full"
    "full"|"slim" detail?;
    # The number of search results to include in a page. Minimum of 1 and maximum of 250
    @http:Query {name: "page_size"}
    int pageSize?;
};

# Request parameters for creating an entirely new entity template
public type CreateEntityTemplate record {|
    # The name of the new entity template
    @constraint:String {maxLength: 128, minLength: 1}
    string name;
    # The id of the user creating this template
    @jsondata:Name {value: "author_id"}
    string authorId?;
    # The story contents the template creates
    @jsondata:Name {value: "story_contents"}
    CreateStoryContents storyContents;
|};

# Represents the Queries record for the operation: search
public type SearchQueries record {
    # The next page token
    string next?;
    # See our help center article on [search operators](https://help.shortcut.com/hc/en-us/articles/360000046646-Search-Operators)
    @constraint:String {minLength: 1}
    string query;
    # A collection of entity_types to search. Defaults to story and epic. Supports: epic, iteration, objective, story
    @http:Query {name: "entity_types"}
    ("story"|"milestone"|"epic"|"iteration"|"objective")[] entityTypes?;
    # The amount of detail included in each result item.
    #    "full" will include all descriptions and comments and more fields on
    #    related items such as pull requests, branches and tasks.
    #    "slim" omits larger fulltext fields such as descriptions and comments
    #    and only references related items by id.
    #    The default is "full"
    "full"|"slim" detail?;
    # The number of search results to include in a page. Minimum of 1 and maximum of 250
    @http:Query {name: "page_size"}
    int pageSize?;
};


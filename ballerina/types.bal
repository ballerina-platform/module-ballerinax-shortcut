# An Iteration is a defined, time-boxed period of development for a collection of Stories. See https://help.shortcut.com/hc/en-us/articles/360028953452-Iterations-Overview for more information
public type Iteration record {|
    # An array of Member IDs that have been mentioned in the Story description
    @jsondata:Name {value: "member_mention_ids"}
    string[] memberMentionIds;
    # The date this iteration ends
    @jsondata:Name {value: "end_date"}
    string endDate;
    # The Shortcut application url for the Iteration
    @jsondata:Name {value: "app_url"}
    string appUrl;
    # An array of label ids attached to the iteration
    @jsondata:Name {value: "label_ids"}
    int[] labelIds;
    # The globally unique identifier of the resource
    @jsondata:Name {value: "global_id"}
    string globalId;
    # The description of the iteration
    string description;
    # The instant when this iteration was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # An array of Group IDs that have been mentioned in the Story description
    @jsondata:Name {value: "group_mention_ids"}
    string[] groupMentionIds;
    # An array of labels attached to the iteration
    Label[] labels;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # An array containing Group IDs and Group-owned story counts for the Iteration's associated groups
    @jsondata:Name {value: "associated_groups"}
    IterationAssociatedGroup[] associatedGroups;
    # The instant when this iteration was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt;
    # A group of calculated values for this Iteration
    IterationStats stats;
    # An array of UUIDs for any Members listed as Followers
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds;
    # The name of the iteration
    string name;
    # An array of UUIDs for any Groups you want to add as Followers. Currently, only one Group association is presented in our web UI
    @jsondata:Name {value: "group_ids"}
    string[] groupIds;
    # The ID of the iteration
    int id;
    # `Deprecated:` use `member_mention_ids`
    @jsondata:Name {value: "mention_ids"}
    string[] mentionIds;
    # The date this iteration begins
    @jsondata:Name {value: "start_date"}
    string startDate;
    # The status of the iteration. Values are either "unstarted", "started", or "done"
    string status;
|};

# An action representing various operations for a Pull Request
public type HistoryActionPullRequest record {|
    # The VCS Repository-specific ID for the Pull Request
    int number;
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The action of the entity referenced
    "open"|"update"|"reopen"|"close"|"sync"|"comment" action;
    # The ID of the entity referenced
    int id;
    # The title of the Pull Request
    string title;
    # The URL from the provider of the VCS Pull Request
    @constraint:String {maxLength: 2048, pattern: re `^https?://.+$`}
    string url;
|};

public type UpdateDoc record {|
    # Default content_format: html. Format of content. For input: specifies format of provided content (defaults to 'html'). For output: controls response format - 'markdown' (default) or 'html' to include HTML content. Because output defaults to markdown, set 'markdown' when editing and writing back content you read from GET
    @jsondata:Name {value: "content_format"}
    "markdown"|"html" contentFormat?;
    # The new title for the document
    @constraint:String {maxLength: 256, minLength: 1}
    string title?;
    # The new content for the document
    string content?;
|};

public type GetDoc record {|
    # Default content_format: markdown. Format of the content to return. If 'html', includes HTML content in response
    @jsondata:Name {value: "content_format"}
    "markdown"|"html" contentFormat?;
|};

# An action representing a Task being created
public type HistoryActionTaskCreate record {|
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The description of the Task
    string description;
    # The action of the entity referenced
    "create" action;
    # An array of Groups IDs that represent which have been mentioned in the Task
    @jsondata:Name {value: "group_mention_ids"}
    string[] groupMentionIds?;
    # The ID of the entity referenced
    int id;
    # Whether or not the Task is complete
    boolean complete;
    # A timestamp that represent's the Task's deadline
    string deadline?;
    # An array of Member IDs that represent the Task's owners
    @jsondata:Name {value: "owner_ids"}
    string[] ownerIds?;
    # An array of Member IDs that represent who has been mentioned in the Task
    @jsondata:Name {value: "mention_ids"}
    string[] mentionIds?;
|};

public type UpdateStoryComment record {|
    # The updated comment text
    @constraint:String {maxLength: 100000}
    string text;
|};

# StorySlim represents the same resource as a Story, but is more light-weight. For certain fields it provides ids rather than full resources (e.g., `comment_ids` and `file_ids`) and it also excludes certain aggregate values (e.g., `cycle_time`). The `description` field can be optionally included. Use the [Get Story](#Get-Story) endpoint to fetch the unabridged payload for a Story
public type StorySlim record {|
    # The ID of the workflow state the story is currently in
    @jsondata:Name {value: "workflow_state_id"}
    int workflowStateId;
    # The ID of the workflow the story belongs to
    @jsondata:Name {value: "workflow_id"}
    int workflowId;
    # The ID of the Member that requested the story
    @jsondata:Name {value: "requested_by_id"}
    string requestedById;
    # The ID of the story template used to create this story, or null if not created using a template
    @jsondata:Name {value: "story_template_id"}
    string? storyTemplateId;
    # The ID of the project the story belongs to
    @jsondata:Name {value: "project_id"}
    int? projectId;
    # The stats object for Stories
    StoryStats stats;
    # The numeric point estimate of the story. Can also be null, which means unestimated
    int? estimate;
    # The unique ID of the Story
    int id;
    # The Story IDs of Sub-tasks attached to the Story
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "sub_task_story_ids"}
    int[] subTaskStoryIds?;
    # An array of CustomField value assertions for the story
    @jsondata:Name {value: "custom_fields"}
    StoryCustomField[] customFields?;
    # The formatted branch name for this story
    @jsondata:Name {value: "formatted_vcs_branch_name"}
    string? formattedVcsBranchName?;
    # An array of label ids attached to the story
    @jsondata:Name {value: "label_ids"}
    int[] labelIds;
    # The globally unique identifier of the resource
    @jsondata:Name {value: "global_id"}
    string globalId;
    # A true/false boolean indicating if the Story has been completed
    boolean completed;
    # An array of labels attached to the story
    LabelSlim[] labels;
    # The ID of the iteration the story belongs to
    @jsondata:Name {value: "iteration_id"}
    int? iterationId;
    # The time/date the Story was completed
    @jsondata:Name {value: "completed_at"}
    string? completedAt;
    # The IDs of the iteration the story belongs to
    @jsondata:Name {value: "previous_iteration_ids"}
    int[] previousIterationIds;
    # An array of external links (strings) associated with a Story
    @jsondata:Name {value: "external_links"}
    string[] externalLinks;
    # The name of the story
    string name;
    # The time/date the Story was started
    @jsondata:Name {value: "started_at"}
    string? startedAt;
    # The cycle time (in seconds) of this story when complete
    @jsondata:Name {value: "cycle_time"}
    int cycleTime?;
    # A number representing the position of the story in relation to every other story in the current project
    int position;
    # A manual override for the time/date the Story was completed
    @jsondata:Name {value: "completed_at_override"}
    string? completedAtOverride;
    # An array of UUIDs of the owners of this story
    @jsondata:Name {value: "owner_ids"}
    string[] ownerIds;
    # An array of IDs of Comments attached to the story
    @jsondata:Name {value: "comment_ids"}
    int[] commentIds;
    # `Deprecated:` use `member_mention_ids`
    @jsondata:Name {value: "mention_ids"}
    string[] mentionIds;
    # A true/false boolean indicating if the Story is currently a blocker of another story
    boolean blocker;
    # The description of the Story
    string description?;
    # An array of IDs of LinkedFiles attached to the story
    @jsondata:Name {value: "linked_file_ids"}
    int[] linkedFileIds;
    # The time/date the Story was created
    @jsondata:Name {value: "created_at"}
    string createdAt;
    # An array of Group IDs that have been mentioned in the Story description
    @jsondata:Name {value: "group_mention_ids"}
    string[] groupMentionIds;
    # This field can be set to another unique ID. In the case that the Story has been imported from another tool, the ID in the other tool can be indicated here
    @jsondata:Name {value: "external_id"}
    string? externalId;
    # The type of story (feature, bug, chore)
    @jsondata:Name {value: "story_type"}
    string storyType;
    # True if the story has been archived or not
    boolean archived;
    # The ID of the parent story to this story (making this story a sub-task).
    # Field only applicable when Sub-task feature is enabled
    @jsondata:Name {value: "parent_story_id"}
    int? parentStoryId?;
    # The time/date the Story was updated
    @jsondata:Name {value: "updated_at"}
    string? updatedAt;
    # A true/false boolean indicating if the Story is currently blocked
    boolean blocked;
    # An array of UUIDs for any Members listed as Followers
    @jsondata:Name {value: "follower_ids"}
    string[] followerIds;
    # The lead time (in seconds) of this story when complete
    @jsondata:Name {value: "lead_time"}
    int leadTime?;
    # An array of IDs of Files attached to the story
    @jsondata:Name {value: "file_ids"}
    int[] fileIds;
    # The due date of the story
    string? deadline;
    # An array of Member IDs that have been mentioned in the Story description
    @jsondata:Name {value: "member_mention_ids"}
    string[] memberMentionIds;
    # The Shortcut application url for the Story
    @jsondata:Name {value: "app_url"}
    string appUrl;
    # The number of tasks on the story which are complete
    @jsondata:Name {value: "num_tasks_completed"}
    int numTasksCompleted;
    # An array of story links attached to the Story
    @jsondata:Name {value: "story_links"}
    TypedStoryLink[] storyLinks;
    # A true/false boolean indicating if the Story has been started
    boolean started;
    # An array of IDs of Tasks attached to the story
    @jsondata:Name {value: "task_ids"}
    int[] taskIds;
    # The external application the story is synced with
    @jsondata:Name {value: "synced_item"}
    SyncedItem syncedItem?;
    # The time/date the Story was last changed workflow-state
    @jsondata:Name {value: "moved_at"}
    string? movedAt;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # A manual override for the time/date the Story was started
    @jsondata:Name {value: "started_at_override"}
    string? startedAtOverride;
    # The ID of the group associated with the story
    @jsondata:Name {value: "group_id"}
    string? groupId;
    # The ID of the epic the story belongs to
    @jsondata:Name {value: "epic_id"}
    int? epicId;
|};

# Branch refers to a VCS branch. Branches are feature branches associated with Shortcut Stories
public type Branch record {|
    # An array of PullRequests attached to the Branch (there is usually only one)
    @jsondata:Name {value: "pull_requests"}
    PullRequest[] pullRequests;
    # A string description of this resource
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # A true/false boolean indicating if the Branch has been deleted
    boolean deleted;
    # The time/date the Branch was updated
    @jsondata:Name {value: "updated_at"}
    string? updatedAt;
    # The name of the Branch
    string name;
    # The time/date the Branch was created
    @jsondata:Name {value: "created_at"}
    string? createdAt;
    # The ID of the Repository that contains the Branch
    @jsondata:Name {value: "repository_id"}
    int repositoryId;
    # The unique ID of the Branch
    int? id;
    # This field is deprecated, and will always be false
    boolean persistent;
    # The IDs of the Branches the Branch has been merged into
    @jsondata:Name {value: "merged_branch_ids"}
    int[] mergedBranchIds;
    # The URL of the Branch
    string url;
|};

# The results of the Epic search query
public type EpicSearchResults record {|
    # The URL path and query string for the next page of search results
    string? next;
    # The total number of matches for the search query. The first 1000 matches can be paged through via the API
    int total;
    # A list of search results
    EpicSearchResult[] data;
|};

public type CreateOrDeleteStoryReaction record {|
    # The emoji short-code to add / remove. E.g. `:thumbsup::skin-tone-4:`
    string emoji;
|};

# Represents the Queries record for the operation: getMember
public type GetMemberQueries record {
    # The unique ID of the Organization to limit the lookup to
    @http:Query {name: "org-public-id"}
    string orgPublicId?;
};

# An action representing a Story Link being created
public type HistoryActionStoryLinkCreate record {|
    # The Story ID of the subject Story
    @jsondata:Name {value: "subject_id"}
    int subjectId;
    # The type of entity referenced
    @jsondata:Name {value: "entity_type"}
    string entityType;
    # The verb describing the link's relationship
    "blocks"|"duplicates"|"relates to" verb;
    # The action of the entity referenced
    "create" action;
    # The ID of the entity referenced
